        client.assert(response.body.cargaHoraria === 20, "carga não atualizada");
    });
%}

### Atividade de OUTRO aluno não pode ser removida — 404, não 204
DELETE {{boletimUrl}}/api/v1/alunos/2/atividades/{{atividadeId}}
Authorization: Bearer {{tokenProfessor}}

> {%
    client.test("responde 404", () => {
        // Sem autenticação, esta checagem de posse é a única coisa separando
        // os dados de um aluno dos de outro.
        client.assert(response.status === 404, "esperado 404, veio " + response.status);
    });
%}

### Remover a atividade — pelo dono
DELETE {{boletimUrl}}/api/v1/alunos/1/atividades/{{atividadeId}}
Authorization: Bearer {{tokenProfessor}}

> {%
    client.test("responde 204", () => {
        client.assert(response.status === 204, "esperado 204, veio " + response.status);
    });
%}

# ── Contrato de erro ───────────────────────────────────────────────────────
# O mesmo formato do infnethub-core, de propósito: através do gateway os dois
# serviços aparecem como uma API só, e o cliente não deveria precisar saber de
# qual deles veio a falha para conseguir ler a resposta.

### Aluno sem registro acadêmico — 404, não lista vazia
# Com o token do PROFESSOR: um aluno pedindo o boletim de outro id recebe 403
# antes de qualquer consulta — a autorização vem primeiro, e é assim que deve
# ser. Para chegar ao 404 é preciso ter permissão de ver o boletim pedido.
GET {{boletimUrl}}/api/v1/boletim/999999
Authorization: Bearer {{tokenProfessor}}
Accept: application/json

> {%
    client.test("responde 404", () => {
        client.assert(response.status === 404, "esperado 404, veio " + response.status);
    });
    client.test("erro em JSON no formato padrão", () => {
        ["timestamp", "status", "error", "message"].forEach(campo =>
            client.assert(response.body[campo] !== undefined, "faltou o campo " + campo));
        client.assert(response.body.status === 404);
    });
%}

### Identificador não numérico — 400
GET {{boletimUrl}}/api/v1/boletim/abc
Authorization: Bearer {{tokenAluno}}
Accept: application/json

> {%
    client.test("responde 400", () => {
        client.assert(response.status === 400, "esperado 400, veio " + response.status);
    });
    client.test("diz qual parâmetro está errado, sem ecoar o valor recebido", () => {
        client.assert(response.body.error === "Parâmetro inválido",
            "erro inesperado: " + response.body.error);
        client.assert(response.body.message.includes("alunoId"), "não indicou o parâmetro");
    });
%}

### Validação de corpo — categoria, nome e carga inválidos
POST {{boletimUrl}}/api/v1/alunos/1/atividades
Authorization: Bearer {{tokenProfessor}}
Content-Type: application/json

{
  "categoria": "XPTO",
  "nome": "",
  "cargaHoraria": -5,
  "status": "CONCLUIDO"
}

> {%
    client.test("responde 400", () => {
        client.assert(response.status === 400, "esperado 400, veio " + response.status);
    });
    client.test("aponta CADA campo inválido, não só o primeiro", () => {
        const campos = response.body.campos;
        client.assert(campos != null, "resposta sem o mapa 'campos'");
        ["categoria", "nome", "cargaHoraria"].forEach(c =>
            client.assert(campos[c] !== undefined, "faltou apontar o campo " + c));
    });
%}

### Rota inexistente — 404 em JSON, nunca HTML
GET {{boletimUrl}}/api/v1/boletim/nao-existe/em-lugar-nenhum
Authorization: Bearer {{tokenAluno}}
Accept: application/json

> {%
    client.test("responde 404 em JSON", () => {
        client.assert(response.status === 404, "esperado 404, veio " + response.status);
        client.assert(response.body.status === 404, "corpo não é o JSON de erro padrão");
    });
%}

### Verbo não suportado — 405
DELETE {{boletimUrl}}/api/v1/desempenho/1
Authorization: Bearer {{tokenProfessor}}

> {%
    client.test("responde 405", () => {
        client.assert(response.status === 405, "esperado 405, veio " + response.status);
    });
%}

### Saúde do serviço
# No ambiente "local" responde o boletim-service; no "gateway", o próprio
# gateway — ele não roteia /actuator, que é endpoint de cada processo. Para
# conferir a saúde do boletim atrás do gateway, use o ambiente "local".
GET {{boletimUrl}}/actuator/health
Authorization: Bearer {{tokenAluno}}
Accept: application/json

> {%
    client.test("responde 200 e está UP", () => {
        client.assert(response.status === 200);
        client.assert(response.body.status === "UP", "status: " + response.body.status);
    });
%}
