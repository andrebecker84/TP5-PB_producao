# Expurgo (LGPD) — a saga, e a compensação dela
#
# Remover uma pessoa envolve três bancos que nenhuma transação alcança ao mesmo
# tempo. Aqui isso é um PROCESSO com estados, e não um DELETE otimista:
#
#   1. a secretaria pede     → o core BLOQUEIA (não apaga) e anuncia
#   2. o boletim decide      → anonimiza, ou recusa com motivo
#   3a. conclui              → o cadastro é anonimizado, agora é definitivo
#   3b. compensa             → o bloqueio é DESFEITO e quem pediu é avisado
#
# Este arquivo ABRE as duas sagas e verifica tudo o que é imediato e
# determinístico: quem pode pedir, o que a resposta promete, e o efeito do
# bloqueio nas leituras. O DESFECHO fica no arquivo seguinte — a explicação
# está no fim deste.
#
# O aluno 1 tem competências em avaliação, então o boletim sempre recusa: não
# se desvincula a identidade de um registro escolar em curso. Por isso este
# arquivo pode ser repetido à vontade — ele termina com tudo como estava.

### Aluno não remove ninguém — 403
DELETE {{baseUrl}}/api/v1/usuarios/2
Authorization: Bearer {{tokenAluno}}

> {%
    client.test("responde 403", () => {
        client.assert(response.status === 403, "esperado 403, veio " + response.status);
    });
%}

### Sem token não se remove ninguém — 401
DELETE {{baseUrl}}/api/v1/usuarios/2

> {%
    client.test("responde 401", () => {
        client.assert(response.status === 401, "esperado 401, veio " + response.status);
    });
%}

### SAGA A · a secretaria pede a remoção do aluno 1 — 202, e não 204
# 204 diria "feito, não há mais nada a dizer". Mas há: o que acontece com os
# dados nos outros serviços ainda está em curso.
DELETE {{baseUrl}}/api/v1/usuarios/1
Authorization: Bearer {{tokenSecretaria}}

> {%
    client.test("responde 202 Accepted", () => {
        client.assert(response.status === 202, "esperado 202, veio " + response.status);
    });
    client.test("o processo nasce em SOLICITADO", () => {
        client.assert(response.body.estado === "SOLICITADO", "estado: " + response.body.estado);
        client.assert(response.body.encerradoEm === null, "já nasceu encerrado?");
        client.assert(response.body.solicitadoPor === 3, "quem pediu veio do token? " + response.body.solicitadoPor);
    });
    client.global.set("sagaA", response.body.id);
%}

### Pedir de novo é conflito, não erro de requisição — 409
# O pedido está bem formado e seria válido em outro momento; o que impede é o
# estado atual do recurso.
#
# Vem IMEDIATAMENTE depois do pedido, e não mais adiante, por um motivo de
# tempo: a janela em que a saga está aberta dura o que a volta dura. Para ela se
# fechar antes desta requisição, os dois relays (de 500 ms cada) teriam de
# disparar, ambos, nas poucas dezenas de milissegundos entre uma requisição e a
# seguinte. A regra em si é coberta, sem depender de tempo, pelo SagaDeExpurgoTest.
DELETE {{baseUrl}}/api/v1/usuarios/1
Authorization: Bearer {{tokenSecretaria}}

> {%
    client.test("responde 409", () => {
        client.assert(response.status === 409, "esperado 409, veio " + response.status);
    });
    client.test("a mensagem explica o motivo", () => {
        client.assert(String(response.body.error).indexOf("andamento") >= 0,
            "mensagem inesperada: " + response.body.error);
    });
%}

### Aluno não lê o histórico de expurgo — 403
GET {{baseUrl}}/api/v1/usuarios/1/expurgo
Authorization: Bearer {{tokenAluno}}
Accept: application/json

> {%
    client.test("responde 403", () => {
        client.assert(response.status === 403, "esperado 403, veio " + response.status);
