%}

### Alterar o post de outra pessoa — 403
# O post 1 é do professor. O aluno autenticado não pode editá-lo nem apagá-lo:
# só o autor ou a moderação (secretaria, coordenação) alteram um conteúdo.
PUT {{baseUrl}}/api/v1/posts/1
Authorization: Bearer {{tokenAluno}}
Content-Type: application/json

{
  "titulo": "Tentativa de alterar o post alheio",
  "conteudo": "Não deveria ser gravado."
}

> {%
    client.test("responde 403", () => {
        client.assert(response.status === 403, "esperado 403, veio " + response.status);
    });
%}

### Apagar o post de outra pessoa — 403
DELETE {{baseUrl}}/api/v1/posts/1
Authorization: Bearer {{tokenAluno}}

> {%
    client.test("responde 403", () => {
        client.assert(response.status === 403, "esperado 403, veio " + response.status);
    });
%}

### Aluno tentando alterar o cadastro de outra pessoa — 403
# O cadastro de pessoas é administrativo: um aluno não troca o nome nem o
# e-mail de ninguém — e a troca seguiria, por evento, para o boletim.
PUT {{baseUrl}}/api/v1/usuarios/4
Authorization: Bearer {{tokenAluno}}
Content-Type: application/json

{
  "nome": "Nome Trocado Por Outra Pessoa",
  "email": "trocado@infnet.edu.br"
}

> {%
    client.test("responde 403", () => {
        client.assert(response.status === 403, "esperado 403, veio " + response.status);
    });
%}

### Aluno tentando cadastrar uma pessoa — 403
POST {{baseUrl}}/api/v1/usuarios
Authorization: Bearer {{tokenAluno}}
Content-Type: application/json

{
  "nome": "Cadastro Que Não Deveria Existir",
  "email": "indevido@infnet.edu.br"
}

> {%
    client.test("responde 403", () => {
        client.assert(response.status === 403, "esperado 403, veio " + response.status);
    });
%}
