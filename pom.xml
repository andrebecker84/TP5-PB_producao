<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- POM agregador. Criado no TP3; o TP4 acrescenta o módulo de contratos
	     das mensagens e o serviço de notificações.
	     Até o TP2 este arquivo era o pom da aplicação inteira: um artefato, um
	     JAR, um processo. A arquitetura distribuída do TP3 tem quatro processos
	     independentes, cada um com seu próprio ciclo de vida e suas próprias
	     dependências, e por isso este pom deixa de produzir artefato
	     (packaging=pom) e passa a agregar os módulos e a centralizar o que eles
	     têm em comum: a versão do Java, o BOM do Spring Cloud e o processador
	     de anotações do Lombok. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.andre</groupId>
	<artifactId>infnethub</artifactId>
	<version>1.0.2</version>
	<packaging>pom</packaging>
	<name>TP5-PB_producao</name>
	<description>TP5 - Implantação e operação em produção: Docker, Kubernetes, observabilidade e CI/CD | Engenharia de Softwares Escaláveis</description>

	<modules>
		<!-- A linguagem comum das mensagens. Vem primeiro porque produtor e
		     consumidor dependem dele: é o que garante que os dois lados leiam
		     o mesmo evento da mesma forma, verificado pelo compilador e não
		     descoberto em produção. -->
		<module>contratos</module>
		<!-- A aplicação que veio do TP2. Continua inteira, com seu banco e sua
		     auditoria: o TP3 acrescenta um serviço ao lado dela, não a divide. -->
		<module>infnethub-core</module>
		<!-- O microsserviço novo: Desempenho Acadêmico, com banco próprio. -->
		<module>boletim-service</module>
		<!-- Nasce no TP4: só consome eventos, e transforma curtidas, comentários
		     e vagas em notificações por usuário, entregues ao vivo. -->
		<module>notificacao-service</module>
		<!-- Infraestrutura de comunicação distribuída. -->
		<module>api-gateway</module>
		<module>eureka-server</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<!-- Spring Cloud tem trem de release próprio, independente do Boot, e um
		     histórico de descompasso entre os dois: a série 2025.0.0 não sobe com
		     o Boot 4.0.1 ou posterior. 2025.1.3 (Oakwood) é a linha que declara
		     compatibilidade com o Boot 4.1.1 usado aqui. Trocar uma das duas
		     versões sem trocar a outra é a forma mais rápida de quebrar o
		     contexto de todos os módulos de uma vez. -->
		<spring-cloud.version>2025.1.3</spring-cloud.version>
		<!-- Testes de integração contra um RabbitMQ real, em contêiner. -->
		<testcontainers.version>2.0.5</testcontainers.version>
		<!-- Cobertura de testes (TP5). A 0.8.14 foi a primeira a ler as classes
		     do Java 25; abaixo dela o agente ignora as classes em silêncio e o
		     relatório sai vazio, sem erro nenhum. -->
		<jacoco.version>0.8.15</jacoco.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Importa o BOM do Spring Cloud: os módulos declaram os starters
			     sem <version>, e a versão coerente com o trem de release sai
			     daqui. É o mesmo mecanismo pelo qual o spring-boot-starter-parent
			     já governa Flyway, driver do PostgreSQL e Hibernate — e a razão
			     de nenhuma dessas versões aparecer fixada à mão no projeto. -->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.andre</groupId>
				<artifactId>contratos</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Herdadas por todos os módulos: os quatro usam Lombok e os quatro têm
	     testes. O que é específico de um módulo fica no pom dele. -->
	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<!-- Só a configuração: versão e execução de repackage já vêm do
				     spring-boot-starter-parent. Fica em pluginManagement, e não em
				     plugins, porque este pom é agregador — declarado aqui como
				     plugin ativo, o repackage tentaria empacotar um artefato que
				     não existe. Cada módulo executável ativa o plugin no seu pom. -->
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<configuration>
						<excludes>
							<exclude>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</exclude>
						</excludes>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!-- Cobertura dos testes (TP5), em todos os módulos. O agente observa
			     as classes durante o "test", e o relatório sai no "verify" — é a
			     fase que o pipeline de CI executa (.github/workflows/ci.yml), e o
			     HTML fica em <módulo>/target/site/jacoco/index.html. Um "mvn test"
			     do dia a dia paga só o agente, não o relatório. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>agente</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>relatorio</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
