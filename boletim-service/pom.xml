<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.andre</groupId>
		<artifactId>infnethub</artifactId>
		<version>1.0.1</version>
	</parent>

	<artifactId>boletim-service</artifactId>
	<name>boletim-service</name>
	<description>Microsserviço de Desempenho Acadêmico - conceitos, competências e blocos, com banco próprio</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Métricas no formato do Prometheus, em /actuator/prometheus. A versão
		     vem do BOM do Spring Boot. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!-- Rastreamento distribuído (TP5). Micrometer Tracing com a ponte para
		     o OpenTelemetry e o exportador OTLP: cada requisição ganha um
		     traceId que atravessa gateway, serviços e RabbitMQ, e os spans
		     seguem para o coletor (Grafana Alloy → Tempo). As métricas
		     continuam saindo pelo Prometheus: o envio de métricas por OTLP que
		     este starter traz fica desligado no application.properties. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry</artifactId>
		</dependency>

		<!-- ── Persistência do banco próprio ────────────────────────────────
		     Mesma pilha do infnethub-core, mas apontada para outra instância de
		     PostgreSQL. É o que caracteriza Database per Service: não é um
		     schema separado dentro do mesmo banco, é outro banco — o boletim não
		     tem como alcançar as tabelas do core nem por engano. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- O spring-boot-flyway é o que executa as migrations no start e as
		     ordena antes do EntityManagerFactory. O flyway-core sozinho traz só
		     a ferramenta: sem este artefato, o Boot 4 sobe com o banco vazio e a
		     validação do Hibernate falha sem explicar por quê. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Fatia @DataJpaTest — módulo próprio desde o Boot 4, não vem no
		     starter-test. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- ── Comunicação com o infnethub-core ─────────────────────────────
		     No TP3 era OpenFeign + Resilience4j: uma chamada HTTP ao core a cada
		     boletim aberto, com circuit breaker para quando ele não respondesse.
		     No TP4 a dependência inverteu de sentido. O core publica o que muda
		     nos usuários; o boletim escuta e guarda a própria cópia. Nenhuma
		     chamada de rede no caminho da leitura — e nada a proteger com
		     circuit breaker. -->
		<dependency>
			<groupId>com.andre</groupId>
			<artifactId>contratos</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>

		<!-- RabbitMQ real, em contêiner, nos testes do consumidor: fila de
		     mensagens mortas, reentrega e duplicata só se provam contra o
		     broker de verdade. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-rabbitmq</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.awaitility</groupId>
			<artifactId>awaitility</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- ── Resource server ────────────────────────────────────────────────
		     O serviço só aceita requisição com token válido do Keycloak. A
		     assinatura é conferida com a chave pública do realm, buscada uma
		     vez e mantida em cache — não há chamada ao Keycloak por
		     requisição. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- MockMvc para os testes das regras de acesso aos endpoints. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Autenticação simulada nos testes (jwt()), sem Keycloak no ar. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>


	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
