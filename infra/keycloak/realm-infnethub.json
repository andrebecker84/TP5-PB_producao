{
  "realm": "infnethub",
  "enabled": true,
  "displayName": "Infnet Hub",
  "displayNameHtml": "Infnet<b>Hub</b>",
  "loginTheme": "infnethub",
  "attributes": {
    "parRequestUriLifespan": "1800"
  },
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR"],
  "defaultLocale": "pt-BR",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "ALUNO",
        "description": "Aluno(a) — vê o próprio boletim e participa do feed"
      },
      {
        "name": "PROFESSOR",
        "description": "Professor(a) — lança conceitos e publica no feed"
      },
      {
        "name": "SECRETARIA",
        "description": "Secretaria — publica vagas e avisos institucionais"
      },
      {
        "name": "COORDENADOR",
        "description": "Coordenador(a) — acompanha o desempenho das turmas"
      },
      {
        "name": "SUPORTE_TI",
        "description": "Suporte de TI: opera a infraestrutura e acessa o painel de operação (Grafana). Não é papel acadêmico."
      }
    ]
  },
  "clients": [
    {
      "clientId": "infnethub-bff",
      "name": "Infnet Hub — BFF (API Gateway)",
      "description": "Cliente confidencial do gateway. É ele que faz o login OIDC; o navegador nunca recebe token, só o cookie de sessão do gateway.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "bff-segredo-de-desenvolvimento",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:21080/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:21080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "require.pushed.authorization.requests": "true",
        "post.logout.redirect.uris": "http://localhost:21000/*##http://localhost:21080/*"
      },
      "protocolMappers": [
        {
          "name": "papeis-do-realm",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "usuario_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "usuario_id",
            "claim.name": "usuario_id",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "infnethub-dev-cli",
      "name": "Infnet Hub — CLI de desenvolvimento",
      "description": "SOMENTE DESENVOLVIMENTO. Cliente público com concessão direta de senha, para a coleção http/ e os scripts de verificação obterem um token sem navegador. Não deve existir em produção: a concessão por senha é desaconselhada pelo OAuth 2.1.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "usuario_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "usuario_id",
            "claim.name": "usuario_id",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "infnethub-grafana",
      "name": "Infnet Hub — Grafana (painel de operação)",
      "description": "Cliente confidencial do Grafana. O painel só aceita quem tem o papel SUPORTE_TI; os demais são recusados no login.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "grafana-segredo-de-desenvolvimento",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:21300/login/generic_oauth"
      ],
      "webOrigins": [
        "http://localhost:21300"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:21000##http://localhost:21000/*"
      },
      "protocolMappers": [
        {
          "name": "papeis-do-realm",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
