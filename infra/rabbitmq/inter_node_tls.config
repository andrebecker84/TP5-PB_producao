%% TLS na conversa entre os nós do RabbitMQ (distribuição Erlang).
%%
%% É por aqui que passam as réplicas das filas quorum — isto é, o conteúdo das
%% mensagens. Verificação nos dois sentidos: cada nó apresenta o certificado e
%% confere o do outro contra a autoridade de desenvolvimento.
[
  {server, [
    {cacertfile, "/certs/ca.crt"},
    {certfile,   "/certs/rabbitmq/servidor.crt"},
    {keyfile,    "/certs/rabbitmq/servidor.key"},
    {secure_renegotiate, true},
    {verify, verify_peer},
    {fail_if_no_peer_cert, true}
  ]},
  {client, [
    {cacertfile, "/certs/ca.crt"},
    {certfile,   "/certs/rabbitmq/servidor.crt"},
    {keyfile,    "/certs/rabbitmq/servidor.key"},
    {secure_renegotiate, true},
    {verify, verify_peer}
  ]}
].
