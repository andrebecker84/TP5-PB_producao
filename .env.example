# ── Modelo de variáveis de ambiente ─────────────────────────────────────────
# Copie para .env e ajuste:  cp .env.example .env
# O .env está no .gitignore e nunca vai para o repositório. Este arquivo é a
# exceção deliberada: documenta as variáveis sem conter valor sensível algum.
#
# Os valores abaixo são de desenvolvimento local e não são credenciais reais.
# Todos têm padrão no docker-compose.yml: o .env só é necessário para mudar
# alguma coisa.

# ── Portas do host ──────────────────────────────────────────────────────────
# O TP5 usa um bloco próprio (21xxx) em vez das usuais 5432/8080/3000/5672.
# Motivo: as portas padrão são as primeiras a serem disputadas por outros
# projetos, e as etapas do projeto integrado (TP1…TP5) podem precisar rodar ao
# mesmo tempo. O TP3 ficou em 19xxx e o TP4 em 20xxx.
#
# Só o que um navegador abre é publicado, e só no 127.0.0.1 da máquina. Os
# serviços Java e o Eureka não têm porta no host: chega-se a eles pelo gateway.
FRONTEND_PORT=21000
GATEWAY_PORT=21080
KEYCLOAK_PORT=21180
GRAFANA_PORT=21300
RABBIT_PAINEL_PORT=21673

# Para rodar um serviço pela IDE contra a infraestrutura do Compose.
DB_PORT=21432
BOLETIM_DB_PORT=21433
NOTIFICACAO_DB_PORT=21434
RABBIT_PORT=21672

# ── Bancos de dados — PostgreSQL 18, um por serviço ────────────────────────
DB_NAME=infnethub
DB_USER=infnethub
DB_PASS=infnethub

BOLETIM_DB_NAME=boletim
BOLETIM_DB_USER=boletim
BOLETIM_DB_PASS=boletim

NOTIFICACAO_DB_NAME=notificacao
NOTIFICACAO_DB_USER=notificacao
NOTIFICACAO_DB_PASS=notificacao

# ── RabbitMQ — cluster de três nós ──────────────────────────────────────────
RABBIT_USER=infnethub
RABBIT_PASS=infnethub
# Segredo compartilhado entre os nós: nós com cookies diferentes não se unem.
RABBIT_COOKIE=infnethub-cluster-dev

# ── TLS ─────────────────────────────────────────────────────────────────────
# Senha do truststore que o gerador de certificados cria no volume
# `certificados` (infra/certificados/gerar.sh). Mudá-la depois da primeira
# subida exige apagar esse volume, para os certificados serem refeitos.
CONFIANCA_SENHA=infnethub-confianca

# ── Keycloak ────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASS=admin
KEYCLOAK_REALM=infnethub
# Segredos dos clientes confidenciais do realm. Precisam bater com os de
# infra/keycloak/realm-infnethub.json.
KEYCLOAK_BFF_SECRET=bff-segredo-de-desenvolvimento
GRAFANA_OIDC_SECRET=grafana-segredo-de-desenvolvimento

# ── Grafana ─────────────────────────────────────────────────────────────────
# O login é pelo Keycloak, e só entra quem tem o papel SUPORTE_TI. O
# administrador local não é usado no dia a dia.
GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASS=admin

# ── Saga de expurgo (LGPD) ──────────────────────────────────────────────────
# Prazo para os participantes responderem. O padrão da aplicação é um dia; no
# Compose é encurtado para caber numa demonstração.
EXPURGO_PRAZO=PT1M
