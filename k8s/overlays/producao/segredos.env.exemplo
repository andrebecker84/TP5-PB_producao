# Modelo dos segredos do overlay de produção. Copie para segredos.env (que não
# é versionado) e preencha. Nenhum valor aqui é válido: são marcadores.
#
# A senha do RabbitMQ precisa bater com o hash do usuário no definitions.json
# usado na instalação (rabbitmqctl hash_password), e os segredos dos clientes
# do Keycloak com os do realm importado.
DB_PASS_CORE=trocar
DB_PASS_BOLETIM=trocar
DB_PASS_NOTIFICACAO=trocar
RABBIT_PASS=trocar
RABBIT_COOKIE=trocar
KEYCLOAK_ADMIN_PASS=trocar
KEYCLOAK_BFF_SECRET=trocar
GRAFANA_ADMIN_PASS=trocar
GRAFANA_OIDC_SECRET=trocar
